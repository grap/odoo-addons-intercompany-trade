<odoo>

    <record id="view_account_move_search" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="to_check" position="after">
                <filter string="Intercompany Trade"
                    name="filter_intercompany_trade"
                    domain="[('intercompany_trade','=',True)]"
                    groups="intercompany_trade.intercompany_trade_user"/>
            </filter>
        </field>
    </record>

    <record id="view_account_move_form" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('type', '!=', 'private'), ('company_id', 'in', (False, company_id, fiscal_company_id))]</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="intercompany_trade"
                    attrs="{'invisible': [('intercompany_trade', '=', False)]}"
                    groups="intercompany_trade.intercompany_trade_user"/>
            </field>
            <field name="company_id" position="after">
                <field name="fiscal_company_id" invisible="1" />
            </field>
        </field>
    </record>

</odoo>
