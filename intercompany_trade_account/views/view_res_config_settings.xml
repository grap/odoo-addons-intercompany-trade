<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">

            <div data-key="account" position="inside">
                <h2>Intercompany Trade Settings</h2>
                <div class="row mt16 o_settings_container" name="export_setting_container">

                    <div class="col-12 col-lg-6 o_setting_box" id="intercompany_trade_account_id">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <label for="intercompany_trade_account_id"/>
                            <span class="fa fa-lg fa-home" title="Values set here are company-specific." aria-label="Values set here are Fiscal Mother company Specific." groups="base.group_multi_company" role="img"/>
                            <div class="text-muted">
                               Typically a 181 account in France.
                            </div>
                            <field name="intercompany_trade_account_id"/>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box" id="intercompany_trade_fiscal_position_id">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <label for="intercompany_trade_fiscal_position_id"/>
                            <span class="fa fa-lg fa-home" title="Values set here are company-specific." aria-label="Values set here are Fiscal Mother company Specific." groups="base.group_multi_company" role="img"/>
                            <field name="intercompany_trade_fiscal_position_id"/>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box" id="intercompany_trade_sale_journal_id">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <label for="intercompany_trade_sale_journal_id"/>
                            <span class="fa fa-lg fa-home" title="Values set here are company-specific." aria-label="Values set here are Fiscal Mother company Specific." groups="base.group_multi_company" role="img"/>
                            <field name="intercompany_trade_sale_journal_id"/>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box" id="intercompany_trade_purchase_journal_id">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <label for="intercompany_trade_purchase_journal_id"/>
                            <span class="fa fa-lg fa-home" title="Values set here are company-specific." aria-label="Values set here are Fiscal Mother company Specific." groups="base.group_multi_company" role="img"/>
                            <field name="intercompany_trade_purchase_journal_id"/>
                        </div>
                    </div>
                </div>
            </div>

        </field>
    </record>

</odoo>
